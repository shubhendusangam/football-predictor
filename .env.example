# Football Prediction Application - Environment Variables
# Copy this file to .env and fill in your actual values

# Football Data API Key (Required for live data)
# Get your free API key from: https://www.football-data.org/client/register
FOOTBALL_API_KEY=your_api_key_here

# Admin Password (IMPORTANT: Change this before deployment!)
# Default is 'changeme' - please set a secure password
ADMIN_PASSWORD=your_secure_password_here

# Application Port (optional - default: 8080)
SERVER_PORT=8080

# Database Configuration (optional - defaults to H2 embedded)
# SPRING_DATASOURCE_URL=jdbc:h2:file:./data/footballdb
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=

# Model Training Service Port (optional - default: 8081)
TRAINING_SERVICE_PORT=8081

# API-Football API Key (for injury data integration)
# Get your key from: https://dashboard.api-football.com
APIFOOTBALL_API_KEY=your_key_from_dashboard.api-football.com

