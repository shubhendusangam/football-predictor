<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <!-- Log file locations -->
        <!-- Use relative path for portability across different environments -->
        <Property name="LOG_DIR">./logs</Property>

        <!-- Console pattern — cleaner, more readable startup logs -->
        <Property name="CONSOLE_PATTERN">
            %d{HH:mm:ss} %highlight{%-5level}{
            FATAL=red blink,
            ERROR=red,
            WARN=yellow,
            INFO=green,
            DEBUG=cyan,
            TRACE=white}
            %cyan{%-30.30c{1.}} : %msg%n%throwable
        </Property>

        <!-- File pattern — full detail, no colour codes -->
        <Property name="FILE_PATTERN">
            %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1} : %msg%n%throwable
        </Property>
    </Properties>

    <!-- ── Appenders ─────────────────────────────────────────────── -->
    <Appenders>

        <!-- Console — coloured output -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${CONSOLE_PATTERN}"/>
        </Console>

        <!-- API requests/responses log -->
        <RollingFile name="ApiLog"
                     fileName="${LOG_DIR}/api/api.log"
                     filePattern="${LOG_DIR}/api/api-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- CSV ingestion log -->
        <RollingFile name="IngestionLog"
                     fileName="${LOG_DIR}/ingestion/ingestion.log"
                     filePattern="${LOG_DIR}/ingestion/ingestion-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- Model training log -->
        <RollingFile name="ModelLog"
                     fileName="${LOG_DIR}/model/model.log"
                     filePattern="${LOG_DIR}/model/model-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- Feature computation log -->
        <RollingFile name="FeatureLog"
                     fileName="${LOG_DIR}/features/features.log"
                     filePattern="${LOG_DIR}/features/features-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- Errors only — all layers write here -->
        <RollingFile name="ErrorLog"
                     fileName="${LOG_DIR}/error/error.log"
                     filePattern="${LOG_DIR}/error/error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${FILE_PATTERN}"/>
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="60"/>
        </RollingFile>

        <!-- Async wrapper — wraps all file appenders for non-blocking I/O -->
        <Async name="AsyncApi">
            <AppenderRef ref="ApiLog"/>
        </Async>
        <Async name="AsyncIngestion">
            <AppenderRef ref="IngestionLog"/>
        </Async>
        <Async name="AsyncModel">
            <AppenderRef ref="ModelLog"/>
        </Async>
        <Async name="AsyncFeature">
            <AppenderRef ref="FeatureLog"/>
        </Async>
        <Async name="AsyncError">
            <AppenderRef ref="ErrorLog"/>
        </Async>

    </Appenders>

    <!-- ── Loggers ────────────────────────────────────────────────── -->
    <Loggers>

        <!-- ═══════════════════════════════════════════════════════════════
             APPLICATION LOGGERS - These are the important ones
             ═══════════════════════════════════════════════════════════════ -->

        <!-- API layer → api.log + console + error.log -->
        <Logger name="com.app.footballprediction.controller"
                level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncApi"/>
            <AppenderRef ref="AsyncError"/>
        </Logger>

        <!-- CSV ingestion → ingestion.log + console + error.log -->
        <Logger name="com.app.footballprediction.service.CsvIngestionService"
                level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncIngestion"/>
            <AppenderRef ref="AsyncError"/>
        </Logger>

        <!-- Model training → model.log + console + error.log -->
        <Logger name="com.app.footballprediction.service.ModelTrainingService"
                level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncModel"/>
            <AppenderRef ref="AsyncError"/>
        </Logger>

        <!-- Feature engineering → features.log + console + error.log -->
        <Logger name="com.app.footballprediction.service.FeatureEngineeringService"
                level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncFeature"/>
            <AppenderRef ref="AsyncError"/>
        </Logger>

        <!-- Main application startup -->
        <Logger name="com.app.footballprediction" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncError"/>
        </Logger>

        <!-- ═══════════════════════════════════════════════════════════════
             FRAMEWORK LOGGERS - Reduce noise during startup
             ═══════════════════════════════════════════════════════════════ -->

        <!-- Spring framework — WARN only, reduces startup noise -->
        <Logger name="org.springframework" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncError"/>
        </Logger>

        <!-- Spring Boot — only show errors -->
        <Logger name="org.springframework.boot" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncError"/>
        </Logger>

        <!-- Spring Web — only important messages -->
        <Logger name="org.springframework.web" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncError"/>
        </Logger>

        <!-- Spring Data/JPA — silence during startup -->
        <Logger name="org.springframework.data" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Hibernate — silence startup noise -->
        <Logger name="org.hibernate" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Hibernate SQL — set to DEBUG to see queries, WARN for silence -->
        <Logger name="org.hibernate.SQL" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- H2 Database — silence -->
        <Logger name="org.h2" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- HikariCP connection pool — silence -->
        <Logger name="com.zaxxer.hikari" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Apache HTTP client — silence -->
        <Logger name="org.apache.http" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Apache Catalina/Tomcat — silence -->
        <Logger name="org.apache.catalina" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="org.apache.tomcat" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Weka ML library — reduce verbosity -->
        <Logger name="weka" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Jackson JSON — silence -->
        <Logger name="com.fasterxml.jackson" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Root — catches everything not matched above -->
        <Root level="WARN">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AsyncError"/>
        </Root>

    </Loggers>

</Configuration>