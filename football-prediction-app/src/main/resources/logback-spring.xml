<!--
    Logback Configuration — football-prediction-app
    ────────────────────────────────────────────────
    Includes the shared base from football-prediction-common,
    then adds app-specific rolling-file appenders and loggers.
-->
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Import shared base (console, error appender, framework loggers) -->
    <include resource="logback-base.xml"/>

    <!-- ═══════════════════════════════════════════════════════════
         APP-SPECIFIC APPENDERS
         ═══════════════════════════════════════════════════════════ -->

    <!-- API requests/responses log -->
    <appender name="ApiFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/api/api.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/api/api-%d{yyyy-MM-dd}-%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- CSV ingestion log -->
    <appender name="IngestionFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/ingestion/ingestion.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/ingestion/ingestion-%d{yyyy-MM-dd}-%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Model training log -->
    <appender name="ModelFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/model/model.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/model/model-%d{yyyy-MM-dd}-%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Feature computation log -->
    <appender name="FeatureFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/features/features.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/features/features-%d{yyyy-MM-dd}-%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Async wrappers for non-blocking file I/O -->
    <appender name="AsyncApi" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="ApiFile"/>
    </appender>

    <appender name="AsyncIngestion" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="IngestionFile"/>
    </appender>

    <appender name="AsyncModel" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="ModelFile"/>
    </appender>

    <appender name="AsyncFeature" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FeatureFile"/>
    </appender>

    <!-- ═══════════════════════════════════════════════════════════
         APPLICATION LOGGERS
         ═══════════════════════════════════════════════════════════ -->

    <!-- API / Controller layer → api.log + console + error.log -->
    <logger name="com.app.footballprediction.controller" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncApi"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <!-- MDC Logging Filter (request entry/exit) → api.log -->
    <logger name="com.app.common.logging.MdcLoggingFilter" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncApi"/>
    </logger>

    <!-- CSV ingestion → ingestion.log + console + error.log -->
    <logger name="com.app.footballprediction.service.CsvIngestionService" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncIngestion"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <logger name="com.app.footballprediction.ingestion" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncIngestion"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <!-- Model training → model.log + console + error.log -->
    <logger name="com.app.footballprediction.modeltraining" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncModel"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <!-- Feature engineering → features.log + console + error.log -->
    <logger name="com.app.common.service.FeatureEngineeringService" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncFeature"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <!-- Polling / sync services → api.log -->
    <logger name="com.app.footballprediction.polling" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncApi"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <!-- Schedulers → console + error.log -->
    <logger name="com.app.footballprediction.scheduler" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <!-- Category loggers (used via AppLoggerFactory) -->
    <logger name="API" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncApi"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <logger name="INGESTION" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncIngestion"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <logger name="MODEL" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncModel"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <logger name="FEATURES" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncFeature"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <logger name="SCHEDULER" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <!-- Main application package — catch-all -->
    <logger name="com.app.footballprediction" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <!-- Common module services -->
    <logger name="com.app.common" level="INFO" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncError"/>
    </logger>

    <!-- ═══════════════════════════════════════════════════════════
         ROOT LOGGER — catches everything not matched above
         ═══════════════════════════════════════════════════════════ -->
    <root level="WARN">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncError"/>
    </root>

</configuration>

